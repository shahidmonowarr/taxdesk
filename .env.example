# Pooled connection used by the app (on Neon: the "-pooler" host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taxdesk"
# Direct connection used by `prisma migrate` (on Neon: the non-pooler host).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/taxdesk"
# Separate database for integration + e2e tests. Every table is truncated.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taxdesk_test"
